<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="https://leis.com/workflow">
    <process id="singleApproval" name="申请审批" isExecutable="true">
        <startEvent id="start"/>
        <sequenceFlow id="toReviewMode" sourceRef="start" targetRef="reviewMode"/>
        <exclusiveGateway id="reviewMode" default="toParallelReview"/>
        <sequenceFlow id="toParallelReview" sourceRef="reviewMode" targetRef="parallelReview"/>
        <sequenceFlow id="toSequentialReview" sourceRef="reviewMode" targetRef="sequentialReview">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${mode == 'SEQUENTIAL'}]]></conditionExpression>
        </sequenceFlow>
        <userTask id="parallelReview" name="并行审批" flowable:assignee="${reviewerId}">
            <multiInstanceLoopCharacteristics isSequential="false" flowable:collection="approverIds"
                                              flowable:elementVariable="reviewerId">
                <completionCondition xsi:type="tFormalExpression"><![CDATA[
                    ${decision == 'RETURN' || (mode == 'ANY' ? decision == 'APPROVE' : decision == 'REJECT')}
                ]]></completionCondition>
            </multiInstanceLoopCharacteristics>
        </userTask>
        <userTask id="sequentialReview" name="顺序审批" flowable:assignee="${reviewerId}">
            <multiInstanceLoopCharacteristics isSequential="true" flowable:collection="approverIds"
                                              flowable:elementVariable="reviewerId">
                <completionCondition xsi:type="tFormalExpression"><![CDATA[
                    ${decision == 'RETURN' || decision == 'REJECT'}
                ]]></completionCondition>
            </multiInstanceLoopCharacteristics>
        </userTask>
        <sequenceFlow id="parallelToResult" sourceRef="parallelReview" targetRef="result"/>
        <sequenceFlow id="sequentialToResult" sourceRef="sequentialReview" targetRef="result"/>
        <exclusiveGateway id="result" default="toRejected"/>
        <sequenceFlow id="toApproved" sourceRef="result" targetRef="approvedEnd">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision == 'APPROVE'}]]></conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="toRevise" sourceRef="result" targetRef="revise">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision == 'RETURN'}]]></conditionExpression>
        </sequenceFlow>
        <userTask id="revise" name="修改并重新提交" flowable:assignee="${applicantId}"/>
        <sequenceFlow id="resubmitted" sourceRef="revise" targetRef="reviewMode"/>
        <sequenceFlow id="toRejected" sourceRef="result" targetRef="rejectedEnd"/>
        <endEvent id="approvedEnd" name="已通过"/>
        <endEvent id="rejectedEnd" name="已驳回"/>
    </process>
</definitions>
